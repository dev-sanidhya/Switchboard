# Required
GROQ_API_KEY=gsk_your_groq_key_here

# Optional - enables Cerebras as a second provider
CEREBRAS_API_KEY=csk_your_cerebras_key_here

# Optional - enables Gemini as a third provider
GEMINI_API_KEY=your_gemini_key_here

# Database (SQLite file path)
DATABASE_URL=./switchboard.db

# Server
PORT=3000
LOG_LEVEL=info

# Cache
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Circuit breaker
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_MS=30000

# Set to true to expose /test/inject-failure endpoint
ENABLE_TEST_ENDPOINTS=false

# Admin API key - required to call /admin/* routes when set.
# If unset, admin routes are open (dev only). Always set this in production.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=
